# Copy this file to .env.local for local dev, and add the same keys
# in Vercel: Project > Settings > Environment Variables

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Phase 3 — FastAPI backend (see /backend). Leave blank in dev if you haven't
# stood up the backend yet: the free-text AI step will just no-op and the
# manual wizard (Phase 2) keeps working exactly as before.
VITE_BACKEND_URL=https://your-backend.onrender.com

# Phase 4 — Firebase Cloud Messaging (push notifications). All optional:
# leave blank and the "Turn on notifications" button in Profile > Settings
# will say notifications aren't configured, but nothing else breaks (see
# src/lib/firebase.js). Get these from Firebase Console > Project Settings >
# General ("Your apps" web config) and > Cloud Messaging (Web Push
# certificate / VAPID key).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

