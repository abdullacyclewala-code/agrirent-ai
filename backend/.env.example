# Phase 3 — LLM provider keys (never commit real keys or put them in frontend code)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Set to your deployed Vercel URL in production (e.g. https://agrirent-ai.vercel.app)
FRONTEND_ORIGIN=*

# Phase 4 — push notifications (all optional; unset = safe no-op, see
# app/notifications.py and backend/README.md "Setting up push notifications")
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
WEBHOOK_SECRET=

# Phase 6 item 2 — multilingual semantic double-check (all optional; unset =
# safe no-op, semantic_match.py falls straight to its difflib last resort.
# See backend/README.md "Multilingual semantic double-check" and
# hf-space-semantic/README.md "Deploying this" for how to stand this up.)
HF_SPACE_URL=
HF_SPACE_API_TOKEN=
HF_SPACE_TIMEOUT_S=45

# ---------------------------------------------------------------------------
# Phase 7 — trust layer (/verification/*). See docs/PHASE7_VERIFIED_CONDITION_REPORTS.md
# and backend/README.md "Trust layer". Everything here is OPTIONAL: with no
# vision keys the endpoints still return a complete report built from the
# deterministic signals (hash / pixel / EXIF / GPS / clock), just with
# ai_status = "unavailable".
# ---------------------------------------------------------------------------

# Order to try vision providers in. Any not configured are skipped silently.
VISION_PROVIDER_ORDER=gemini,groq,cloudflare
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
CF_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct

# Public by design (it ships in the frontend bundle). Only used to validate a
# caller's user JWT when SUPABASE_SERVICE_ROLE_KEY is not set.
SUPABASE_ANON_KEY=

# Stamped into every report + settlement so an old decision stays explainable.
TRUST_POLICY_VERSION=2026-10-1
