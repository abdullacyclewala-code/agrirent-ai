# Phase 3 — LLM provider keys (never commit real keys or put them in frontend code)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Set to your deployed Vercel URL in production (e.g. https://agrirent-ai.vercel.app)
FRONTEND_ORIGIN=*

# Phase 4 — push notifications (all optional; unset = safe no-op, see
# app/notifications.py and backend/README.md "Setting up push notifications")
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
WEBHOOK_SECRET=

# Phase 6 item 2 — multilingual semantic double-check (all optional; unset =
# safe no-op, semantic_match.py falls straight to its difflib last resort.
# See backend/README.md "Multilingual semantic double-check" and
# hf-space-semantic/README.md "Deploying this" for how to stand this up.)
HF_SPACE_URL=
HF_SPACE_API_TOKEN=
HF_SPACE_TIMEOUT_S=45
